<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Схема и данные в разных changeSet -->
    <changeSet id="v1.0-create-tables" author="yu.ufimtsev">
        <sqlFile path="sql/01-create-tables.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/01-create-tables.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="v1.0-seed-data" author="yu.ufimtsev">
        <sqlFile path="sql/02-seed-data.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/02-seed-data.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
